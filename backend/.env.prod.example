# 프로덕션(경로 A · Oracle VM)용 환경변수 템플릿.
#   VM에서:  cp .env.prod.example .env.prod  → 값 채우기 → docker-compose.prod.yml이 --env-file 로 읽음.
#   ⚠️ .env.prod 는 절대 git에 올리지 않는다(.gitignore 확인). 시크릿은 VM에만.

# ── MySQL (컨테이너 DB — VM 내부에서만 접근) ─────────────────────────
MYSQL_DATABASE=commerce
MYSQL_USER=commerce
MYSQL_PASSWORD=              # 강한 랜덤 비밀번호로 교체
MYSQL_ROOT_PASSWORD=         # 강한 랜덤 비밀번호로 교체(위와 다르게)

# ── 보안 ────────────────────────────────────────────────────────────
# JWT 서명키 — HS384라 48바이트 이상. 생성 예: openssl rand -base64 48
JWT_SECRET=

# ── 도메인 / 쿠키 (FE 배포 후 확정) ──────────────────────────────────
# FE origin(Vercel 주소 또는 커스텀 도메인). 콤마로 여러 개 가능.
APP_CORS_ALLOWED_ORIGINS=https://<your-app>.vercel.app
# HTTPS 프로덕션: secure=true 고정. SameSite=None이면 크로스사이트/같은사이트 모두 동작(Secure와 한 쌍).
APP_COOKIE_SECURE=true
APP_COOKIE_SAME_SITE=None
# Caddy/nginx 리버스 프록시 뒤 → framework(X-Forwarded-* 신뢰). 프록시 없이 직접 노출이면 none.
SERVER_FORWARD_HEADERS_STRATEGY=framework
# 공개 배포 보안: actuator는 health만 노출(uptime 핑용). prometheus/metrics/caches를 열면
#   인터넷 누구나 JVM·Hikari·엔드포인트별 트래픽·캐시 통계를 스크레이프할 수 있다(정찰 정보).
MANAGEMENT_ENDPOINTS=health
# 소셜 로그인 켤 때만 필요 — 로그인 성공 후 돌아갈 FE 주소.
APP_OAUTH2_REDIRECT=https://<your-app>.vercel.app

# 데모 데이터 시드(빈 사이트 방지). 비우면 시드 안 함.
SPRING_PROFILES_ACTIVE=dev

# ── 소셜 로그인 (선택 — 비우면 비활성, 로컬 로그인만) ────────────────
# 콘솔의 승인된 리디렉션 URI에 https://<백엔드도메인>/login/oauth2/code/{google|kakao} 등록 필요.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
