# 이 파일을 복사해 .env 로 만들고 값을 채운다. (.env 는 git 추적 제외)
# docker-compose가 .env를 자동으로 읽고, Spring 앱은 run.ps1이 OS 환경변수로 로드한다.

# MySQL (docker-compose + 앱 datasource 공용)
MYSQL_DATABASE=commerce
MYSQL_USER=commerce
MYSQL_PASSWORD=change-me-strong-password
MYSQL_ROOT_PASSWORD=change-me-strong-root-password

# JWT 서명 시크릿 (HS384 → 48바이트 이상 권장)
JWT_SECRET=change-me-to-a-long-random-secret-at-least-48-bytes

# 소셜 로그인(구글). Google Cloud Console에서 발급한 OAuth 2.0 Client ID/Secret.
#  - 비워 두면 소셜 로그인 비활성(기존 로컬 로그인만 동작) — opt-in.
#  - Google Cloud 콘솔의 "승인된 리디렉션 URI"에 등록: http://localhost:8080/login/oauth2/code/google
#    (배포 후엔 https://<백엔드주소>/login/oauth2/code/google 도 추가)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 소셜 로그인 성공 후 돌아갈 FE 주소(로컬 기본 http://localhost:3000). 배포 시 Vercel 주소로.
# APP_OAUTH2_REDIRECT=http://localhost:3000
